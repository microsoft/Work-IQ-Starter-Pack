                "Chats": [
                    {
                        "Title": "Finance Operations",
                        "Members": [
                            "Babak Shammas",
                            "Serena Ribeiro",
                            "David Power"
                        ],
                        "Messages": [
                            {
                                "Offset": -21,
                                "Time": "08:30:00",
                                "Sender": "Babak Shammas",
                                "Message": "Morning. Northstar Fill Finish's deviation investigation line is on hold - no approval on record. Heads up if you get questions from their side."
                            },
                            {
                                "Offset": -21,
                                "Time": "08:42:00",
                                "Sender": "David Power",
                                "Message": "Nothing from me. Sales doesn't touch Northstar invoices."
                            },
                            {
                                "Offset": -14,
                                "Time": "15:10:00",
                                "Sender": "Babak Shammas",
                                "Message": "New one: BluePeak Biologics L004 on INV-SUP-009-2026-Q4-L004 is a contamination investigation charge. Disputed, pay the rest."
                            },
                            {
                                "Offset": -14,
                                "Time": "15:14:00",
                                "Sender": "Serena Ribeiro",
                                "Message": "@Babak Shammas will you want the line items in the monthly spend summary? I'm pulling it Friday."
                            },
                            {
                                "Offset": -14,
                                "Time": "15:20:00",
                                "Sender": "Babak Shammas",
                                "Message": "Yes, show it as disputed, not approved. I'll update the status once Compliance weighs in."
                            },
                            {
                                "Offset": -7,
                                "Time": "09:05:00",
                                "Sender": "Babak Shammas",
                                "Message": "Status: L004 is escalated. Cassandra has the written position and Charlotte agreed it."
                            }
                        ]
                    },
                    {
                        "Title": "Procurement Leadership",
                        "Members": [
                            "Charlotte Waltson",
                            "Babak Shammas"
                        ],
                        "Messages": [
                            {
                                "Offset": -13,
                                "Time": "09:10:00",
                                "Sender": "Charlotte Waltson",
                                "Message": "@Babak Shammas thanks for holding L004. Please open the case and loop in Cassandra today."
                            },
                            {
                                "Offset": -13,
                                "Time": "09:25:00",
                                "Sender": "Babak Shammas",
                                "Message": "Done. Case is in the Financial Investigation Case list, status Disputed."
                            },
                            {
                                "Offset": -8,
                                "Time": "10:30:00",
                                "Sender": "Charlotte Waltson",
                                "Message": "Compliance position is clear: supplier-caused investigations aren't billable. I want the contract amended so we're never back here."
                            },
                            {
                                "Offset": -8,
                                "Time": "10:40:00",
                                "Sender": "Babak Shammas",
                                "Message": "Makes sense. I'll add a mandatory deviation reference per invoice line to the request."
                            },
                            {
                                "Offset": -2,
                                "Time": "08:50:00",
                                "Sender": "Charlotte Waltson",
                                "Message": "Amendment approved and going to BluePeak Biologics for signature."
                            }
                        ]
                    },
                    {
                        "Title": "Compliance Review",
                        "Members": [
                            "Cassandra Dunn",
                            "Babak Shammas",
                            "Charlotte Waltson"
                        ],
                        "Messages": [
                            {
                                "Offset": -12,
                                "Time": "15:30:00",
                                "Sender": "Cassandra Dunn",
                                "Message": "@Babak Shammas I've read the deviation record for DEV-BP-1026-SUPPLIER. Root cause points to the supplier."
                            },
                            {
                                "Offset": -12,
                                "Time": "15:35:00",
                                "Sender": "Babak Shammas",
                                "Message": "That matches my read. No change order on file either."
                            },
                            {
                                "Offset": -12,
                                "Time": "15:50:00",
                                "Sender": "Cassandra Dunn",
                                "Message": "Section 4 of the billability policy covers it. Decision state is escalated."
                            },
                            {
                                "Offset": -8,
                                "Time": "16:30:00",
                                "Sender": "Cassandra Dunn",
                                "Message": "Position sent to BluePeak Biologics. @Charlotte Waltson I'll update you when they reply."
                            },
                            {
                                "Offset": -8,
                                "Time": "16:40:00",
                                "Sender": "Charlotte Waltson",
                                "Message": "Thanks. Keep me posted."
                            }
                        ]
